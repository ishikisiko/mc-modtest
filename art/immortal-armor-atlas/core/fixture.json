{
  "id": "engine_fixture",
  "name": "青衡校样",
  "level": 2,
  "realm": "筑基",
  "style": "内核完整校样",
  "tagline": "以一套连续衣甲检验九类几何与统一棚光",
  "palette": [
    "#74858a",
    "#183d43",
    "#a7cbbd",
    "#c8ae72"
  ],
  "description": "这套衣甲只用于渲染内核校验，不进入十五款作者设计目录。造型以修长肩腰比为起点，灰青连续护身和深色长绫形成清楚的材质主次，冠额向上收束，衣摆向下舒展。它应当从正、侧、背三个方向都保持完整体积；局部玉肩与细金嵌边增加层次，却不把整套衣甲拆成一片片补丁。观察时应能辨出金属面上的长条棚灯反射、织物较宽柔的明暗和透明晶体的边缘。",
  "silhouette": "人体头宽与肩宽遵守统一概念比例，腰部微收，肩袖向两侧自然下降。长摆前方开口，披帛向后舒展，冠顶没有巨大光圈抢夺主体；从背后看，冠壳、肩线、竖脊和连续长衣形成独立而清晰的构图。单件视图移去人台，检验每件是否拥有内外面、底缘厚度与真正的侧向轮廓。",
  "materialStory": "灰青金属对应低扁削角锭的侧壁，顶面以淡玉绿色表达精炼后的清润感，浅金边缘暗示工艺的收束。墨色内衬与青绫只承担柔软层，不将高金属度随意用于全部材料。晶体只在前额和锭顶保留两枚小点，半透明但不凭发光撑起整套设计。这些是视觉材质说明，不暗示已实现的游戏功能。",
  "progression": "本校样展示筑基层级的清贵仪装，衣甲有连续曲面和清晰边缘，玉料与金属分工成熟。相较初阶，应观察到体块与内层衣料之间更多的空间关系；相较更高境界，则仍保留人间匠造的重量，不使用大型背轮、失重碎片或全身发光。实际十五套的升级依据由各境作者另写。",
  "segmentation": "局部只使用左右各一片的肩部护面与一体式前胸玉面，整套主体是连续金属壳、完整袖筒、垂坠衣摆和独立靴体。横向腰缘是连续环形结构而非切片堆叠。这个校样检验局部轮廓片的倒角与嵌边，不将局部分片泛化为全身的构造语言。",
  "parts": {
    "head": {
      "name": "拢月冠",
      "description": "连续的弧形冠壳包住后脑与两侧，以前额一枚修长冠叶提起视觉重心。额前透晶克制点睛，耳侧小玉珠展示曲面与金属的反差。头颅按真实人的颧骨、额部与下颌比例塑造，保留中性表情，不能以圆球或像素脸充当完整头部。"
    },
    "chest": {
      "name": "青绫合仪衣",
      "description": "主体为从腰至肩连续收放的金属曲面，颈根处另有立领形成内外层次。深青袖筒覆盖整条手臂，金属护腕由椭圆截面逐圈收紧。两肩仅有一片小护面，抬起袖根的轮廓而不主宰全身结构。后背竖线与双侧披帛保持可辨的背面秩序。"
    },
    "legs": {
      "name": "垂云下裳",
      "description": "下装用带厚度的开襟曲面形成完整衣摆，底缘的细微波纹检验环截面和衣料法线。前方留出窄长负空间，中央垂带有明确宽窄和弯曲。内侧双腿由独立长裤覆盖，侧看可见裙与裤的距离，背面则保留连续的深青体块，避免方板补丁衣的视觉。"
    },
    "boots": {
      "name": "青玉履",
      "description": "脚踝、靴筒与长向脚面连为完整体积，鞋尖沿人体正前方伸出。玉面顶壳用实心倒角轮廓封住脚背，细金边检验 panel 嵌边和旋转的世界变换。左右靴均有独立模型，不用一根腿筒冒充脚履，整套最低点与足底坐标一致。"
    }
  },
