  "roles": {
    "guide": {
      "greeting": [
        "阡镇药庐正在招灵草学徒。沈岚缺人照看幼苗，愿教肯做事的新人基础吐纳；你若想找份短工，可以自己去问问。"
      ]
    },
    "pharmacist": {
      "greeting": [
        "药庐要补种几畦灵叶，正缺人手。你若想找份短工，我们可以谈谈。"
      ]
    },
    "zhou_he": {
      "greeting": [
        "学徒的事问沈岚便好。先把日子安顿下来，路上的事往后再说。"
      ]
    },
    "warden": {
      "greeting": [
        "先安顿自己的修行。水脉的事不急着让初来的学徒承担。"
      ]
    }
  },
